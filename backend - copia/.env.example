# PostgreSQL connection string from Supabase.
# Prefer the Supabase pooler URL for a long-running API on Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Custom PostgreSQL schema
DB_SCHEMA=administracion

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,https://tu-front.vercel.app

# Optional shared API key. Leave empty to disable.
API_KEY=cambiar-por-una-clave-larga

# API metadata
APP_NAME=Dirac Administración API
APP_ENV=production
